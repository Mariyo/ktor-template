<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [%X{call-id}] %logger{24} - %msg%n</pattern>
        </encoder>
    </appender>
    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
    <logger name="io.netty" level="WARN"/>
    <!-- Silences the unused default registry Ktor's MicrometerMetrics instantiates before ours is set. -->
    <logger name="io.micrometer" level="WARN"/>
</configuration>
