#!/usr/bin/env bash
set -euo pipefail

# Snapshot before formatting touches anything, so only originally staged files get re-added.
staged_files="$(git diff --cached --name-only --diff-filter=ACM -- '*.kt' '*.kts')"

./gradlew --quiet formatKotlin

# Pick up ktlint's fixes without pulling in unrelated working-tree changes.
if [[ -n "$staged_files" ]]; then
    git add -- $staged_files
fi

# Catches whatever formatKotlin can't auto-fix; the same check runs again in CI as the source of truth.
if ! ./gradlew --quiet lintKotlin; then
    echo "lintKotlin failed after auto-format; fix the remaining issues manually, then re-stage and commit." >&2
    exit 1
fi

# Only the fast in-process suite runs here; server/browser tests stay in CI so commits aren't blocked on slow HTTP/browser startup.
if ! ./gradlew --quiet test; then
    echo "Unit tests failed; fix them, then re-stage and commit." >&2
    exit 1
fi
