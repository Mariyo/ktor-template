{
  "version": "0.2.0",
  "configurations": [
    {
      // F5 starts the watch build + server via the "dev" task, then attaches.
      // The debugger survives hot reloads, so you only ever attach once.
      "type": "intellij_debugger",
      "request": "attach",
      "name": "Debug Ktor (hot reload)",
      "hostName": "localhost",
      "port": 5005,
      // Generous: a cold Gradle daemon plus first compile can take a while.
      "timeout": 120000,
      "preLaunchTask": "dev"
    },
    {
      // Runs "test: debug" (--debug-jvm, suspended) on the currently open *Test.kt file, then attaches.
      // Separate port from the app (5005) because Gradle's own --debug-jvm default is 5005 too.
      "type": "intellij_debugger",
      "request": "attach",
      "name": "Debug tests",
      "hostName": "localhost",
      "port": 5007,
      "timeout": 120000,
      "preLaunchTask": "test: debug"
    }
  ]
}
