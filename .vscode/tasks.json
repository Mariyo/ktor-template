{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Ktor Template - Build",
            "type": "shell",
            "command": "./gradlew",
            "args": [
                "classes",
                "-x",
                "test",
                "--no-daemon"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Ktor Template - Watch Classes",
            "type": "shell",
            "command": "./gradlew",
            "args": [
                "classes",
                "-t",
                "-x",
                "test",
                "--no-daemon",
                "-Dkotlin.incremental=false"
            ],
            "isBackground": true,
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "runOptions": {
                "instanceLimit": 1
            }
        },
        {
            "label": "Ktor Template - Test",
            "type": "shell",
            "command": "./gradlew",
            "args": [
                "test",
                "--no-daemon"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Ktor Template - Clean",
            "type": "shell",
            "command": "./gradlew",
            "args": [
                "clean",
                "--no-daemon"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Ktor Template - Run App",
            "type": "shell",
            "command": "./gradlew",
            "args": [
                "run",
                "--no-daemon"
            ],
            "isBackground": true,
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "runOptions": {
                "instanceLimit": 1
            }
        },
        {
            "label": "Ktor Template - Start Dev Loop",
            "type": "shell",
            "command": "echo",
            "args": [
                "Starting app and watch tasks"
            ],
            "dependsOn": [
                "Ktor Template - Watch Classes",
                "Ktor Template - Run App"
            ],
            "dependsOrder": "parallel",
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            }
        },
        {
            "label": "Ktor Template - Stop Dev Loop",
            "type": "shell",
            "command": "pkill -f 'GradleDaemon|GradleMain|org.gradle.launcher.GradleMain' || true",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Ktor Template - Start containers",
            "type": "shell",
            "command": "docker compose -f infra/localhost/docker-compose.yaml up --build",
            "isBackground": true,
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "Ktor Template - Stop containers",
            "type": "shell",
            "command": "docker compose -f infra/localhost/docker-compose.yaml down",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}