{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Ktor Template - Build",
            "type": "shell",
            "command": "docker",
            "args": [
                "container",
                "exec",
                "-i",
                "ktor-template-app-1",
                "./gradlew",
                "classes",
                "-x",
                "test",
                "--no-daemon"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Ktor Template - Build on change",
            "type": "shell",
            "command": "docker",
            "args": [
                "container",
                "exec",
                "-i",
                "ktor-template-app-1",
                "./gradlew",
                "classes",
                "-t",
                "-x",
                "test",
                "--no-daemon"
            ],
            "isBackground": true,
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "Ktor Template - Test",
            "type": "shell",
            "command": "docker",
            "args": [
                "container",
                "exec",
                "-i",
                "ktor-template-app-1",
                "./gradlew",
                "test",
                "--no-daemon"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Ktor Template - Clean",
            "type": "shell",
            "command": "docker",
            "args": [
                "container",
                "exec",
                "-i",
                "ktor-template-app-1",
                "./gradlew",
                "clean",
                "--no-daemon"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Ktor Template - Start containers",
            "type": "shell",
            "command": "docker compose -f infra/localhost/docker-compose.yaml up --build",
            "isBackground": true,
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "Ktor Template - Stop containers",
            "type": "shell",
            "command": "docker compose -f infra/localhost/docker-compose.yaml down",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}