{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Devcontainer: Build",
            "type": "shell",
            "command": "./gradlew",
            "args": [
                "classes",
                "-x",
                "test",
                "--no-daemon"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Devcontainer: Watch Classes",
            "type": "shell",
            "command": "./gradlew",
            "args": [
                "classes",
                "-t",
                "-x",
                "test",
                "--no-daemon",
                "-Dkotlin.incremental=false"
            ],
            "isBackground": true,
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "runOptions": {
                "instanceLimit": 1
            }
        },
        {
            "label": "Devcontainer: Test",
            "type": "shell",
            "command": "./gradlew",
            "args": [
                "test",
                "--no-daemon"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Devcontainer: Clean",
            "type": "shell",
            "command": "./gradlew",
            "args": [
                "clean",
                "--no-daemon"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Devcontainer: Run App",
            "type": "shell",
            "command": "./gradlew",
            "args": [
                "run",
                "--no-daemon"
            ],
            "isBackground": true,
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "runOptions": {
                "instanceLimit": 1
            }
        },
        {
            "label": "Devcontainer: Wait for Debug Port",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "for ((i=0; i<60; i++)); do (echo > /dev/tcp/127.0.0.1/5005) >/dev/null 2>&1 && echo Debug_port_ready && exit 0; sleep 0.5; done; echo Timeout_waiting_for_debug_port; exit 1"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            }
        },
        {
            "label": "Devcontainer: Start Dev Loop",
            "type": "shell",
            "command": "echo",
            "args": [
                "Starting app and watch tasks"
            ],
            "dependsOn": [
                "Devcontainer: Watch Classes",
                "Devcontainer: Run App",
                "Devcontainer: Wait for Debug Port"
            ],
            "dependsOrder": "parallel",
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            }
        },
        {
            "label": "Devcontainer: Stop Dev Loop",
            "type": "shell",
            "command": "pkill -f 'GradleDaemon|GradleMain|org.gradle.launcher.GradleMain' || true",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Localhost: Ktor Template - Start containers",
            "type": "shell",
            "command": "docker compose -f infra/localhost/docker-compose.yaml up --build",
            "isBackground": true,
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "Localhost: Ktor Template - Stop containers",
            "type": "shell",
            "command": "docker compose -f infra/localhost/docker-compose.yaml down",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}